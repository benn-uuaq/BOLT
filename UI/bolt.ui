                <property name="title">
                 <string>로봇 지점 이동</string>
                </property>
                <layout class="QGridLayout" name="gridLayout_21" rowstretch="1,6" columnstretch="1,6,1">
                 <item row="1" column="0">
                  <widget class="QGroupBox" name="groupBox_11">
                   <property name="title">
                    <string/>
                   </property>
                   <layout class="QVBoxLayout" name="verticalLayout_2">
                    <item>
                     <widget class="QPushButton" name="waypoint_pose_btn">
                      <property name="sizePolicy">
                       <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
                        <horstretch>0</horstretch>
                        <verstretch>0</verstretch>
                       </sizepolicy>
                      </property>
                      <property name="styleSheet">
                       <string notr="true">/* 1. 모든 관련 버튼 공통 기본 스타일 (파란색) */
#home_pose_btn, #waypoint_pose_btn, 
#pose_1_btn, #pose_2_btn, #pose_3_btn, #pose_4_btn, #pose_5_btn, 
#pose_6_btn, #pose_7_btn, #pose_8_btn, #pose_9_btn, #pose_10_btn, #pose_11_btn,
#cell_1_btn, #cell_2_btn {
    color: #ffffff;
    background-color: #0076c4; /* 기본 배경: 파란색 */
    font: bold 16pt &quot;Arial&quot;;
    border: 1px solid #ffffff;
    border-radius: 10px;
    border-bottom: 3px solid #003366;
    border-right: 3px solid #003366;
    margin-top: 4px;                 
    margin-bottom: 4px;
}

/* 2. 비활성화 상태 (Disabled): 회색 */
#home_pose_btn:disabled, #waypoint_pose_btn:disabled,
#pose_1_btn:disabled, #pose_2_btn:disabled, #pose_3_btn:disabled, #pose_4_btn:disabled, #pose_5_btn:disabled, 
#pose_6_btn:disabled, #pose_7_btn:disabled, #pose_8_btn:disabled, #pose_9_btn:disabled, #pose_10_btn:disabled, #pose_11_btn:disabled,
#cell_1_btn:disabled, #cell_2_btn:disabled {
    background-color: #888888 !important; /* 배경 강제 회색 */
    color: #cccccc;
    border: 1px solid #aaaaaa;
    border-bottom: 3px solid #555555;
    border-right: 3px solid #555555;
}

/* 3. 버튼이 체크(눌려 있는 유지 상태)되었을 때: 확실한 초록색 */
#home_pose_btn:checked, #waypoint_pose_btn:checked,
#pose_1_btn:checked, #pose_2_btn:checked, #pose_3_btn:checked, #pose_4_btn:checked, #pose_5_btn:checked, 
#pose_6_btn:checked, #pose_7_btn:checked, #pose_8_btn:checked, #pose_9_btn:checked, #pose_10_btn:checked, #pose_11_btn:checked,
#cell_1_btn:checked, #cell_2_btn:checked {
    background-color: #6ac529 !important; /* 배경 강제 초록색 */
    border-bottom: 3px solid #439608;
    border-right: 3px solid #439608;
}

/* 5. 클릭하는 순간 (눌리는 애니메이션) */
#home_pose_btn:pressed, #waypoint_pose_btn:pressed,
#pose_1_btn:pressed, #pose_2_btn:pressed, #pose_3_btn:pressed, #pose_4_btn:pressed, #pose_5_btn:pressed, 
#pose_6_btn:pressed, #pose_7_btn:pressed, #pose_8_btn:pressed, #pose_9_btn:pressed, #pose_10_btn:pressed, #pose_11_btn:pressed,
#cell_1_btn:pressed, #cell_2_btn:pressed {
    background-color: #005a9e;
    border-top: 3px solid #003366;
    border-left: 3px solid #003366;
    border-bottom: none;
    border-right: none;
    margin-top: 6px;
    margin-bottom: 2px;
}</string>
                      </property>
