	margin-bottom: 4px;
}
#quality_log_btn:hover {
	background-color: #006CC1;
	border-radius: 5px;
	border-bottom: 3px solid #003366;
	border-right: 3px solid #003366;
	margin-top: 4px;                 
	margin-bottom: 4px;
}
#quality_log_btn:pressed {
	background-color: #005a9e;
	border-radius: 5px;
	border-bottom: 1px solid #003366;
	border-right: 1px solid #003366;
	margin-top: 6px;
	margin-bottom: 6px;
}</string>
                </property>
                <property name="text">
                 <string>📂 이전 기록 보기</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QTableWidget" name="history_table">
             <property name="styleSheet">
              <string notr="true">/* 테이블 기본 배경 및 글씨 */
QTableWidget {
    background-color: #333333;
    color: #ffffff;
    font-size: 16px;
    gridline-color: #D0D0D0; /* 표 테두리 선 색상 */
    border: 2px solid #0078D7;
}
/* 헤더(맨 윗줄) 디자인 */
QHeaderView::section {
    background-color: #0078D7; /* 파란색 포인트 */
    color: white;
    font-weight: bold;
    font-size: 18px;
    padding: 5px;
    border: 1px solid #005a9e;
}

/* 선택된 줄(Row) 강조 */
QTableWidget::item:selected {
    background-color: #555555;
    color: #FFD700; /* 선택 시 노란색 글씨로 강조 */
}
QScrollBar:vertical {
	border: none;
	background-color: #efefef; 
	width: 35px;               
	margin: 0px;
}
QScrollBar::handle:vertical {
	background-color: #555555; 
	min-height: 80px; 
	height: 80px;     
    border-radius: 15px;       
    margin: 2px;               
}
QScrollBar::handle:vertical:hover {
	background-color: #0078D7; 
}
QScrollBar::handle:vertical:pressed {
	background-color: #005a9e; 
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;               
	subcontrol-origin: margin;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
	background: none;          
}</string>
             </property>
