             <layout class="QGridLayout" name="gridLayout_6">
              <item row="0" column="0">
               <layout class="QGridLayout" name="gridLayout_5" rowstretch="4,1" columnstretch="1,1">
                <item row="1" column="0">
                 <widget class="QPushButton" name="buzzer_off_button">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
                    <horstretch>1</horstretch>
                    <verstretch>1</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="styleSheet">
                   <string notr="true">/* 1. 기본 상태 (파란색) */
#buzzer_off_button {
	color: rgb(255, 255, 255);
	background-color: rgb(0, 119, 196);
	font: bold 16pt &quot;Arial&quot;;
	border: 1px solid rgb(0, 0, 0);
	border-radius: 5px;
	border-bottom: 3px solid #003366;
	border-right: 3px solid #003366;
	margin-top: 4px;                 
	margin-bottom: 4px;
}

/* 2. 마우스 올렸을 때 (살짝 어두운 파란색) */
#buzzer_off_button:hover {
	background-color: #006CC1;
	border-radius: 5px;
	border-bottom: 3px solid #003366;
	border-right: 3px solid #003366;
	margin-top: 4px;                 
	margin-bottom: 4px;
}

/* 3. 기본 상태에서 클릭할 때 (푹 들어간 파란색) */
#buzzer_off_button:pressed {
	background-color: #005a9e;
	border-radius: 5px;
	border-top: 1px solid #003366;
	border-left: 1px solid #003366;
	border-bottom: none; /* 눌렸을 땐 아래 그림자 제거 */
	border-right: none;
	margin-top: 6px; /* 위로 마진을 줘서 실제로 내려가는 효과 */
	margin-bottom: 2px;
}

/* =================================================== */
/* 4. 토글(음소거)된 상태 (초록색) - :checked 사용! */
/* =================================================== */
#buzzer_off_button:checked {
	color: #ffffff;
	background-color: #6ac529;
	font: bold 16pt &quot;Arial&quot;;
	border: 1px solid #ffffff;
	border-radius: 10px;
	border-bottom: 3px solid #439608;
	border-right: 3px solid #439608;
	margin-top: 4px;                 
	margin-bottom: 4px;
}

/* 5. 토글된(초록) 상태에서 마우스 올렸을 때 (살짝 어두운 초록) */
#buzzer_off_button:checked:hover {
	background-color: #5ab022; /* 기존 파란색 hover 간섭 방지 */
}

/* 6. 토글된(초록) 상태에서 클릭할 때 (푹 들어간 초록색) */
#buzzer_off_button:checked:pressed {
	background-color: #4b941c;
	border-top: 1px solid #439608;
	border-left: 1px solid #439608;
	border-bottom: none;
	border-right: none;
	margin-top: 6px;
	margin-bottom: 2px;
}</string>
                  </property>
                  <property name="text">
                   <string>부저 음소거</string>
                  </property>
                 </widget>
